{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shuqixiao/doc-sync/main/schemas/doc-sync.schema.json",
  "title": "doc-sync configuration",
  "description": "Maps exact document paths to source patterns that may affect them.",
  "type": "object",
  "required": ["documents"],
  "additionalProperties": false,
  "properties": {
    "documents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "allOf": [
          { "$ref": "#/$defs/relativePath" },
          { "not": { "pattern": "[?*\\[]|/$" } }
        ]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/relativePath" }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "description": "A non-empty repository-relative path without dot segments.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.{1,2}(?:/|$)).+"
    }
  }
}
