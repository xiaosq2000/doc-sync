{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xiaosq2000/doc-sync/main/schemas/doc-sync.schema.json",
  "title": "doc-sync configuration",
  "description": "Maps documents to source patterns that may affect them.",
  "type": "object",
  "required": ["documents"],
  "additionalProperties": false,
  "properties": {
    "sets": {
      "description": "Named source lists that documents include with `@name`.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]*$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/source" }
      }
    },
    "documents": {
      "description": "Maps each document path or glob to its sources.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "allOf": [
          { "$ref": "#/$defs/relativePath" },
          { "not": { "pattern": "/$|\\{dir\\}" } }
        ]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "anyOf": [
            { "$ref": "#/$defs/source" },
            { "$ref": "#/$defs/setReference" }
          ]
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "description": "A non-empty repository-relative path without dot segments.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.{1,2}(?:/|$)).+"
    },
    "source": {
      "anyOf": [
        {
          "description": "A source pattern relative to the repository root.",
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "not": { "pattern": "^@|\\{dir\\}" } }
          ]
        },
        {
          "description": "A root path that starts with `@`.",
          "type": "string",
          "pattern": "^\\./@(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\{dir\\}).+"
        },
        {
          "description": "A source pattern relative to the document's directory.",
          "type": "string",
          "pattern": "^\\{dir\\}(?:/(?!\\.(?:/|$))(?:(?!\\{dir\\})[^/])*)*$"
        }
      ]
    },
    "setReference": {
      "description": "Inserts the set with this name from `[sets]`.",
      "type": "string",
      "pattern": "^@[a-z0-9][a-z0-9_-]*$"
    }
  }
}
