{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doc-sync.toml",
  "type": "object",
  "required": ["version", "watch"],
  "properties": {
    "version": {
      "const": 2
    },
    "watch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["paths", "docs"],
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "docs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
